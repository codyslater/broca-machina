{
  "_comment": "Example MCP registration for a host that supports channel notifications (e.g. Claude Code). Copy to .mcp.json, set an ABSOLUTE cwd to your broca-machina checkout, and edit adapters/mcp.config.example.json first (discord IDs + stt/tts). The host launches the voice loop as an MCP server named 'broca-machina'; speech arrives as a channel event and the host replies with the `speak` tool. The bot token comes from $DISCORD_VOICE_BOT_TOKEN (or the tokenFile named in the adapter config), never from this file.",
  "mcpServers": {
    "broca-machina": {
      "command": "bun",
      "args": ["src/voice_loop.js", "adapters/mcp.config.example.json"],
      "cwd": "/ABS/PATH/TO/broca-machina"
    }
  }
}
